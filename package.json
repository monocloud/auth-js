{
  "name": "@monocloud/auth-js",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "gen:docs:html": "rimraf docs/html && typedoc --options ./docs-gen/typedoc.html.mjs",
    "gen:docs:post-markdown": "node ./docs-gen/post-generate.mjs",
    "gen:docs:markdown": "rimraf docs/markdown && typedoc --options ./docs-gen/typedoc.markdown.mjs && pnpm run gen:docs:post-markdown",
    "gen:docs": "pnpm gen:docs:html && pnpm gen:docs:markdown",
    "lint": "turbo run lint:ts && turbo run lint:es -- --fix",
    "test": "turbo run test",
    "changeset:version": "changeset version && pnpm install --lockfile-only --engine-strict=false",
    "changeset:publish": "changeset publish && git push --follow-tags",
    "prepare": "husky",
    "local:registry": "./scripts/publish-local.sh",
    "local:clean": "./scripts/clean-local.sh",
    "delete:all": "./scripts/delete-all.sh",
    "postinstall": "chmod +x ./scripts/delete-all.sh && chmod +x ./scripts/publish-local.sh && chmod +x ./scripts/clean-local.sh"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "glob": "13.0.6",
    "globals": "17.7.0",
    "happy-dom": "20.10.6",
    "husky": "9.1.7",
    "jose": "6.2.3",
    "nyc": "18.0.0",
    "prettier": "3.8.5",
    "rimraf": "6.1.3",
    "shx": "0.4.0",
    "timekeeper": "2.3.1",
    "tsdown": "0.22.9",
    "turbo": "2.10.5",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=11"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
