# Used by the example API server (the SDK reads the MONOCLOUD_BACKEND_* variables)
MONOCLOUD_BACKEND_TENANT_DOMAIN=https://<your-tenant-domain>
MONOCLOUD_BACKEND_AUDIENCE=https://<your-api-identifier>

# API client credentials — used for token introspection
# (the /api/introspected endpoint, and validating opaque tokens)
MONOCLOUD_BACKEND_CLIENT_ID=<your-api-client-id>
MONOCLOUD_BACKEND_CLIENT_SECRET=<your-api-client-secret>

# Used by scripts/get-token.ts to request a machine-to-machine (M2M) access token
M2M_CLIENT_ID=<your-m2m-client-id>
M2M_CLIENT_SECRET=<your-m2m-client-secret>
M2M_SCOPES=data:write
