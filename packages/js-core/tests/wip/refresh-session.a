import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
import { setSession, testInstance, VanillaJsMockStorage } from './utils';
import {
  MonoCloudSession,
  ResponseTypes,
} from '@monocloud/private-common-js-auth';
import { now } from '@monocloud/private-common-js-auth/internal';
import {
  fetchBuilder,
  generateIdToken,
  MockWindow,
} from '@monocloud/test-utils';
import {
  MonoCloudHttpError,
  MonoCloudOPError,
  MonoCloudValidationError,
} from '@monocloud/private-core-js-auth';
import { MonoCloudJsError } from '../src';
import { serializeError } from '../src/errors';

describe('instance.refreshSession() Tests', () => {
  let mockWindow: MockWindow;
  let storage: VanillaJsMockStorage;

  beforeEach(() => {
    mockWindow = new MockWindow();
    storage = new VanillaJsMockStorage();
  });

  afterEach(() => {
    mockWindow.restore();
    window.localStorage.clear();
  });

  it('should throw if no session exists', async () => {
    const instance = testInstance({ storage });

    try {
      await instance.refreshSession();
      throw new Error();
    } catch (e) {
      expect(e).toBeInstanceOf(MonoCloudValidationError);
      expect(e.message).toBe(
        'Ensure the user is authenticated before refreshing the session'
      );
    }
  });

  it('Refresh Token Mode - should throw an error if there is no refresh token', async () => {
    const session: MonoCloudSession = {
      user: { sub: 'sub' },
      accessToken: 'at',
      accessTokenExpiration: now() + 1000,
    };

    setSession(storage, session);

    const instance = testInstance({ storage });

    expect(instance.getSession()).toBeDefined();

    try {
      await instance.refreshSession({
        mode: 'refresh_token',
      });
      throw new Error();
    } catch (e) {
      expect(e).toBeInstanceOf(MonoCloudValidationError);
      expect(e.message).toBe(
        'Refresh token not found. Sign in with offline_access scope to get the refresh token.'
      );
    }
  });

  it('should throw error if the code is not running in the main window', async () => {
    const openerSpy1 = vi.spyOn(window, 'opener', 'get').mockReturnValue(null);
    const openerSpy2 = vi
      .spyOn(window, 'parent', 'get')
      .mockReturnValue({} as unknown as Window);
    const openerSpy3 = vi
      .spyOn(window, 'top', 'get')
      .mockReturnValue({} as unknown as Window);
    const instance = testInstance({ storage });

    try {
      await instance.refreshSession();
      throw new Error();
    } catch (e) {
      expect(e).toBeInstanceOf(MonoCloudJsError);
      expect(e.message).toBe(
        'Initiating an authentication flow in a popup or iframe is not supported'
      );
    }

    openerSpy1.mockClear();
    openerSpy2.mockClear();
    openerSpy3.mockClear();
  });

  it('Refresh Token Mode - should refresh successfully', async () => {
    const idToken = await generateIdToken();

    const fetchSpy = fetchBuilder()
      .configureMetadata()
      .configureJwks()
      .configureRefreshToken({
        idToken,
        accessToken: 'newAt',
        refreshToken: 'newRt',
        body: 'grant_type=refresh_token&refresh_token=rt',
      })
      .configureUserinfo({ accessToken: 'newAt' })
      .createSpy();

    const session: MonoCloudSession = {
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: now() + 1000,
    };

    setSession(storage, session);

    const instance = testInstance({ storage });

    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });

    instance
      .refreshSession({
        mode: 'refresh_token',
      })
      .then();

    const sessionNew = {
      user: {
        sub: 'sub',
        sub_jwk: expect.any(Object),
        username: 'username',
      },
      accessToken: 'newAt',
      refreshToken: 'newRt',
      idToken,
      scopes: 'openid offline_access',
      accessTokenExpiration: expect.any(Number),
    };

    await vi.waitFor(() => {
      fetchSpy.assert();
      storage.expectSession(sessionNew).expectCallbackStateRemoved();
      expect(instance.getSession()).toEqual(sessionNew);
    });
  });

  it('Refresh Token Mode - should throw an error when refreshing session fails', async () => {
    const fetchSpy = fetchBuilder()
      .configureMetadata()
      .configureRefreshToken({
        responseCode: 500,
        body: 'grant_type=refresh_token&refresh_token=rt',
      })
      .createSpy();

    const session: MonoCloudSession = {
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: now() + 1000,
    };

    setSession(storage, session);

    const instance = testInstance({ storage });

    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });

    try {
      await instance.refreshSession({
        mode: 'refresh_token',
      });
      throw new Error();
    } catch (e) {
      expect(e).toBeInstanceOf(MonoCloudHttpError);
      expect(e.message).toBe(
        'Error while performing refresh token grant. Unexpected status code: 500'
      );
    }

    fetchSpy.assert();
    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });
  });

  it.each(['code', 'code id_token'])(
    'Popup Mode - should refresh session through popup and resolve when a session message is received - %s',
    async responseType => {
      const fetchSpy = fetchBuilder().configureMetadata().createSpy();

      mockWindow.assert();

      const mockPopup = {
        close: vi.fn(),
      } as unknown as Window;

      const popupSpy = vi.spyOn(window, 'open').mockReturnValue(mockPopup);

      const session: MonoCloudSession = {
        user: { sub: 'sub' },
        accessToken: 'at',
        refreshToken: 'rt',
        accessTokenExpiration: now() + 1000,
      };

      setSession(storage, session);

      const instance = testInstance({
        storage,
        responseType: responseType as ResponseTypes,
      });

      expect(instance.getSession()).toEqual({
        user: { sub: 'sub' },
        accessToken: 'at',
        refreshToken: 'rt',
        accessTokenExpiration: expect.any(Number),
      });

      instance.refreshSession({ mode: 'popup' }).then();

      const sessionNew = {
        user: {
          sub: 'sub',
        },
        accessToken: 'newAt',
        refreshToken: 'newRt',
        idToken: 'idToken',
        scopes: 'openid offline_access',
        accessTokenExpiration: 1000,
      };

      await vi.waitFor(() => {
        storage
          .expectCallbackState()
          .expectCallbackStateState()
          .expectCallbackStateNonce()
          .expectCallbackStateCodeVerifier()
          .expectCallbackStateParamLocation(
            responseType === 'code' ? 'query' : 'hash'
          )
          .expectCallbackStateSignOut(undefined)
          .expectCallbackStateMaxAge(undefined)
          .expectCallbackStateMode('popup');
      });

      window.dispatchEvent(
        new MessageEvent('message', {
          data: {
            success: true,
            source: 'monocloud-javascript-sdk',
            result: sessionNew,
          },
          source: mockPopup,
          origin: 'http://localhost:3000',
        })
      );

      await vi.waitFor(() => {
        expect(window.open).toBeCalledWith(
          expect.stringContaining('https://example.com/connect/authorize'),
          expect.any(String),
          expect.any(String)
        );
        expect(mockPopup.close).toBeCalled();
        storage.expectSession(sessionNew).expectCallbackStateRemoved();
        expect(instance.getSession()).toEqual(sessionNew);
        fetchSpy.assert();
      });

      popupSpy.mockClear();
    }
  );

  it('Popup Mode - should reject when an error message is received', async () => {
    const fetchSpy = fetchBuilder().configureMetadata().createSpy();

    mockWindow.assert();

    const mockPopup = {
      close: vi.fn(),
    } as unknown as Window;

    const popupSpy = vi.spyOn(window, 'open').mockReturnValue(mockPopup);

    const session: MonoCloudSession = {
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: now() + 1000,
    };

    setSession(storage, session);

    const instance = testInstance({ storage });

    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });

    const error = new MonoCloudOPError('some_error', 'something went wrong');

    let thrown = false;

    instance
      .refreshSession({ mode: 'popup' })
      .then()
      .catch(e => {
        expect(e).instanceOf(MonoCloudOPError);
        expect(e.error).toBe(error.error);
        expect(e.errorDescription).toBe(error.errorDescription);
        thrown = true;
      });

    await vi.waitFor(() => {
      storage
        .expectCallbackState()
        .expectCallbackStateState()
        .expectCallbackStateNonce()
        .expectCallbackStateCodeVerifier()
        .expectCallbackStateParamLocation('query')
        .expectCallbackStateSignOut(undefined)
        .expectCallbackStateMaxAge(undefined)
        .expectCallbackStateMode('popup');
    });

    window.dispatchEvent(
      new MessageEvent('message', {
        data: {
          success: false,
          source: 'monocloud-javascript-sdk',
          serializedError: serializeError(error),
        },
        source: mockPopup,
        origin: 'http://localhost:3000',
      })
    );

    await vi.waitFor(() => {
      expect(window.open).toBeCalledWith(
        expect.stringContaining('https://example.com/connect/authorize'),
        expect.any(String),
        expect.any(String)
      );
      expect(mockPopup.close).toBeCalled();
      storage
        .expectSession({
          user: { sub: 'sub' },
          accessToken: 'at',
          refreshToken: 'rt',
          accessTokenExpiration: expect.any(Number),
        })
        .expectCallbackStateRemoved();
      expect(instance.getSession()).toEqual({
        user: { sub: 'sub' },
        accessToken: 'at',
        refreshToken: 'rt',
        accessTokenExpiration: expect.any(Number),
      });
      expect(thrown).toBe(true);
      fetchSpy.assert();
    });

    popupSpy.mockClear();
  });

  it('Popup Mode - can timeout', async () => {
    const fetchSpy = fetchBuilder().configureMetadata().createSpy();

    mockWindow.assert();

    const mockPopup = {
      close: vi.fn(),
    } as unknown as Window;

    const popupSpy = vi.spyOn(window, 'open').mockReturnValue(mockPopup);

    const session: MonoCloudSession = {
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: now() + 1000,
    };

    setSession(storage, session);

    const instance = testInstance({
      storage,
      authWindowTimeout: 0.1,
    });

    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });

    let thrown = false;

    instance
      .refreshSession({ mode: 'popup' })
      .then()
      .catch(e => {
        expect(e).instanceOf(MonoCloudJsError);
        expect(e.message).toBe('Refresh session window timed out');
        thrown = true;
      });

    await vi.waitFor(() => {
      storage
        .expectCallbackState()
        .expectCallbackStateState()
        .expectCallbackStateNonce()
        .expectCallbackStateCodeVerifier()
        .expectCallbackStateParamLocation('query')
        .expectCallbackStateSignOut(undefined)
        .expectCallbackStateMaxAge(undefined)
        .expectCallbackStateMode('popup');
    });

    await vi.waitFor(() => {
      expect(window.open).toBeCalledWith(
        expect.stringContaining('https://example.com/connect/authorize'),
        expect.any(String),
        expect.any(String)
      );
      expect(mockPopup.close).toBeCalled();
      storage
        .expectSession({
          user: { sub: 'sub' },
          accessToken: 'at',
          refreshToken: 'rt',
          accessTokenExpiration: expect.any(Number),
        })
        .expectCallbackStateRemoved();
      expect(instance.getSession()).toEqual({
        user: { sub: 'sub' },
        accessToken: 'at',
        refreshToken: 'rt',
        accessTokenExpiration: expect.any(Number),
      });
      expect(thrown).toBe(true);
      fetchSpy.assert();
    });

    popupSpy.mockClear();
  });

  it('Popup Mode - should throw an error if popup fails to open', async () => {
    const fetchSpy = fetchBuilder().configureMetadata().createSpy();

    mockWindow.assert();

    const popupSpy = vi.spyOn(window, 'open').mockReturnValue(null);

    const session: MonoCloudSession = {
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: now() + 1000,
    };

    setSession(storage, session);

    const instance = testInstance({ storage });

    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });

    try {
      await instance.refreshSession({ mode: 'popup' });
      throw new Error();
    } catch (e) {
      expect(e).instanceOf(MonoCloudJsError);
      expect(e.message).toBe('Could not open popup');
    }

    storage
      .expectSession({
        user: { sub: 'sub' },
        accessToken: 'at',
        refreshToken: 'rt',
        accessTokenExpiration: expect.any(Number),
      })
      .expectCallbackStateRemoved();
    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });

    fetchSpy.assert();
    popupSpy.mockClear();
  });

  it('Silent Mode - should refresh session through iframe and resolve when a session message is received', async () => {
    const fetchSpy = fetchBuilder().configureMetadata().createSpy();

    mockWindow.assert();

    const iframe = window.document.createElement('iframe');

    const createElementSpy = vi
      .spyOn(window.document, 'createElement')
      .mockReturnValue(iframe);
    const contentWindowSpy = vi
      .spyOn(iframe, 'contentWindow', 'get')
      .mockReturnValue(window);
    const appendChildSpy = vi.spyOn(window.document.body, 'appendChild');
    const setAttributeSpy = vi
      .spyOn(iframe, 'setAttribute')
      .mockImplementation(() => {});

    const session: MonoCloudSession = {
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: now() + 1000,
    };

    setSession(storage, session);

    const instance = testInstance({ storage });

    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });

    instance.refreshSession().then().catch();

    await vi.waitFor(() => {
      storage
        .expectCallbackState()
        .expectCallbackStateMode('silent')
        .expectCallbackStateCodeVerifier()
        .expectCallbackStateMaxAge(undefined)
        .expectCallbackStateNonce()
        .expectCallbackStateParamLocation('query')
        .expectCallbackStateSignOut(undefined)
        .expectCallbackStateState();

      expect(window.document.body.appendChild).toHaveBeenCalledWith(iframe);
      expect(iframe.setAttribute).toHaveBeenLastCalledWith(
        'src',
        expect.stringContaining('https://example.com/connect/authorize')
      );
    });

    const sessionNew = {
      user: {
        sub: 'sub',
      },
      accessToken: 'newAt',
      refreshToken: 'newRt',
      idToken: 'idToken',
      scopes: 'openid offline_access',
      accessTokenExpiration: 1000,
    };

    window.dispatchEvent(
      new MessageEvent('message', {
        data: {
          success: true,
          source: 'monocloud-javascript-sdk',
          result: sessionNew,
        },
        source: window,
        origin: 'http://localhost:3000',
      })
    );

    await vi.waitFor(() => {
      window.document.body.childNodes.forEach(x => {
        expect(x.nodeName).not.toBe('IFRAME');
      });
      storage.expectSession(sessionNew).expectCallbackStateRemoved();
      expect(instance.getSession()).toEqual(sessionNew);
      fetchSpy.assert();
    });

    createElementSpy.mockClear();
    contentWindowSpy.mockClear();
    appendChildSpy.mockClear();
    setAttributeSpy.mockClear();
  });

  it('Silent Mode - should reject when an error message is received', async () => {
    const fetchSpy = fetchBuilder().configureMetadata().createSpy();

    mockWindow.assert();

    const iframe = window.document.createElement('iframe');

    const createElementSpy = vi
      .spyOn(window.document, 'createElement')
      .mockReturnValue(iframe);
    const contentWindowSpy = vi
      .spyOn(iframe, 'contentWindow', 'get')
      .mockReturnValue(window);
    const appendChildSpy = vi.spyOn(window.document.body, 'appendChild');
    const setAttributeSpy = vi
      .spyOn(iframe, 'setAttribute')
      .mockImplementation(() => {});

    const session: MonoCloudSession = {
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: now() + 1000,
    };

    setSession(storage, session);

    const instance = testInstance({ storage });

    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });

    const error = new MonoCloudOPError('some_error', 'something went wrong');

    let thrown = false;

    instance
      .refreshSession()
      .then()
      .catch(e => {
        expect(e).toBeInstanceOf(MonoCloudOPError);
        expect(e.error).toBe(error.error);
        expect(e.errorDescription).toBe(error.errorDescription);
        thrown = true;
      });

    await vi.waitFor(() => {
      storage
        .expectCallbackState()
        .expectCallbackStateMode('silent')
        .expectCallbackStateCodeVerifier()
        .expectCallbackStateMaxAge(undefined)
        .expectCallbackStateNonce()
        .expectCallbackStateParamLocation('query')
        .expectCallbackStateSignOut(undefined)
        .expectCallbackStateState();

      expect(window.document.body.appendChild).toHaveBeenCalledWith(iframe);
      expect(iframe.setAttribute).toHaveBeenLastCalledWith(
        'src',
        expect.stringContaining('https://example.com/connect/authorize')
      );
    });

    window.dispatchEvent(
      new MessageEvent('message', {
        data: {
          success: false,
          source: 'monocloud-javascript-sdk',
          serializedError: serializeError(error),
        },
        source: window,
        origin: 'http://localhost:3000',
      })
    );

    await vi.waitFor(() => {
      expect(thrown).toBe(true);
      window.document.body.childNodes.forEach(x => {
        expect(x.nodeName).not.toBe('IFRAME');
      });
      storage.expectSession(session).expectCallbackStateRemoved();
      expect(instance.getSession()).toEqual(session);
      fetchSpy.assert();
    });

    createElementSpy.mockClear();
    contentWindowSpy.mockClear();
    appendChildSpy.mockClear();
    setAttributeSpy.mockClear();
  });

  it('Silent Mode - can timeout', async () => {
    const fetchSpy = fetchBuilder().configureMetadata().createSpy();

    mockWindow.assert();

    const iframe = window.document.createElement('iframe');

    const createElementSpy = vi
      .spyOn(window.document, 'createElement')
      .mockReturnValue(iframe);
    const appendChildSpy = vi.spyOn(window.document.body, 'appendChild');
    const setAttributeSpy = vi
      .spyOn(iframe, 'setAttribute')
      .mockImplementation(() => {});

    const session: MonoCloudSession = {
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: now() + 1000,
    };

    setSession(storage, session);

    const instance = testInstance({
      storage,
      authWindowTimeout: 0.1,
    });

    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });

    let thrown = false;

    instance
      .refreshSession()
      .then()
      .catch(e => {
        expect(e).instanceOf(MonoCloudJsError);
        expect(e.message).toBe('Refresh session window timed out');
        thrown = true;
      });

    await vi.waitFor(() => {
      storage
        .expectCallbackState()
        .expectCallbackStateMode('silent')
        .expectCallbackStateCodeVerifier()
        .expectCallbackStateMaxAge(undefined)
        .expectCallbackStateNonce()
        .expectCallbackStateParamLocation('query')
        .expectCallbackStateSignOut(undefined)
        .expectCallbackStateState();

      expect(window.document.body.appendChild).toHaveBeenCalledWith(iframe);
      expect(iframe.setAttribute).toHaveBeenLastCalledWith(
        'src',
        expect.stringContaining('https://example.com/connect/authorize')
      );
    });

    await vi.waitFor(() => {
      expect(thrown).toBe(true);
      window.document.body.childNodes.forEach(x => {
        expect(x.nodeName).not.toBe('IFRAME');
      });
      storage.expectSession(session).expectCallbackStateRemoved();
      expect(instance.getSession()).toEqual(session);
      fetchSpy.assert();
    });

    createElementSpy.mockClear();
    appendChildSpy.mockClear();
    setAttributeSpy.mockClear();
  });

  it('Popup Mode - throws when user closes the window', async () => {
    const fetchSpy = fetchBuilder().configureMetadata().createSpy();

    const popup = window.open();

    const popupSpy = vi.spyOn(window, 'open').mockReturnValue(popup);

    const session: MonoCloudSession = {
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: now() + 1000,
    };

    setSession(storage, session);

    const instance = testInstance({ storage });

    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });

    let thrown = false;

    instance
      .refreshSession({ mode: 'popup' })
      .then()
      .catch(e => {
        expect(e).toBeInstanceOf(MonoCloudJsError);
        expect(e?.message).toBe('Refresh session window closed by user');
        thrown = true;
      });

    popup?.close();

    await vi.waitFor(() => {
      storage.expectCallbackStateRemoved();
      expect(thrown).toBe(true);
      fetchSpy.assert();
    });

    popupSpy.mockClear();
  });

  it('should only resolve the promise if the origin is appUrl', async () => {
    const fetchSpy = fetchBuilder().configureMetadata().createSpy();

    mockWindow.assert();

    const mockPopup = {
      close: vi.fn(),
    } as unknown as Window;

    const popupSpy = vi.spyOn(window, 'open').mockReturnValue(mockPopup);

    const session: MonoCloudSession = {
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: now() + 1000,
    };

    setSession(storage, session);

    const instance = testInstance({
      storage,
      responseType: 'code',
    });

    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });

    instance.refreshSession({ mode: 'popup' }).then();

    await vi.waitFor(() => {
      storage.expectCallbackState();
    });

    const sessionNew = {
      user: {
        sub: 'sub',
      },
      accessToken: 'newAt',
      refreshToken: 'newRt',
      idToken: 'idToken',
      scopes: 'openid offline_access',
      accessTokenExpiration: 1000,
    };

    window.dispatchEvent(
      new MessageEvent('message', {
        data: {
          success: true,
          source: 'monocloud-javascript-sdk',
          result: sessionNew,
        },
        source: mockPopup,
        origin: 'https://hackersite.com',
      })
    );

    expect(mockPopup.close).not.toBeCalled();

    window.dispatchEvent(
      new MessageEvent('message', {
        data: {
          success: true,
          source: 'monocloud-javascript-sdk',
          result: sessionNew,
        },
        source: mockPopup,
        origin: 'http://localhost:3000',
      })
    );

    await vi.waitFor(() => {
      expect(mockPopup.close).toBeCalled();
      expect(instance.getSession()).toEqual(sessionNew);
      fetchSpy.assert();
    });

    popupSpy.mockClear();
  });

  it('should only resolve the promise if the source is parent window', async () => {
    const fetchSpy = fetchBuilder().configureMetadata().createSpy();

    mockWindow.assert();

    const mockPopup = {
      close: vi.fn(),
    } as unknown as Window;

    const popupSpy = vi.spyOn(window, 'open').mockReturnValue(mockPopup);

    const session: MonoCloudSession = {
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: now() + 1000,
    };

    setSession(storage, session);

    const instance = testInstance({
      storage,
      responseType: 'code',
    });

    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });

    instance.refreshSession({ mode: 'popup' }).then();

    await vi.waitFor(() => {
      storage.expectCallbackState();
    });

    const sessionNew = {
      user: {
        sub: 'sub',
      },
      accessToken: 'newAt',
      refreshToken: 'newRt',
      idToken: 'idToken',
      scopes: 'openid offline_access',
      accessTokenExpiration: 1000,
    };

    window.dispatchEvent(
      new MessageEvent('message', {
        data: {
          success: true,
          source: 'monocloud-javascript-sdk',
          result: sessionNew,
        },
        source: {} as unknown as Window,
        origin: 'http://localhost:3000',
      })
    );

    expect(mockPopup.close).not.toBeCalled();

    window.dispatchEvent(
      new MessageEvent('message', {
        data: {
          success: true,
          source: 'monocloud-javascript-sdk',
          result: sessionNew,
        },
        source: mockPopup,
        origin: 'http://localhost:3000',
      })
    );

    await vi.waitFor(() => {
      expect(mockPopup.close).toBeCalled();
      expect(instance.getSession()).toEqual(sessionNew);
      fetchSpy.assert();
    });

    popupSpy.mockClear();
  });

  it('should only resolve the promise if data.source is monocloud-javascript-sdk', async () => {
    const fetchSpy = fetchBuilder().configureMetadata().createSpy();

    mockWindow.assert();

    const mockPopup = {
      close: vi.fn(),
    } as unknown as Window;

    const popupSpy = vi.spyOn(window, 'open').mockReturnValue(mockPopup);

    const session: MonoCloudSession = {
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: now() + 1000,
    };

    setSession(storage, session);

    const instance = testInstance({
      storage,
      responseType: 'code',
    });

    expect(instance.getSession()).toEqual({
      user: { sub: 'sub' },
      accessToken: 'at',
      refreshToken: 'rt',
      accessTokenExpiration: expect.any(Number),
    });

    instance.refreshSession({ mode: 'popup' }).then();

    await vi.waitFor(() => {
      storage.expectCallbackState();
    });

    const sessionNew = {
      user: {
        sub: 'sub',
      },
      accessToken: 'newAt',
      refreshToken: 'newRt',
      idToken: 'idToken',
      scopes: 'openid offline_access',
      accessTokenExpiration: 1000,
    };

    window.dispatchEvent(
      new MessageEvent('message', {
        data: {
          success: true,
          source: 'someoneelse',
          result: sessionNew,
        },
        source: mockPopup,
        origin: 'http://localhost:3000',
      })
    );

    expect(mockPopup.close).not.toBeCalled();

    window.dispatchEvent(
      new MessageEvent('message', {
        data: {
          success: true,
          source: 'monocloud-javascript-sdk',
          result: sessionNew,
        },
        source: mockPopup,
        origin: 'http://localhost:3000',
      })
    );

    await vi.waitFor(() => {
      expect(mockPopup.close).toBeCalled();
      expect(instance.getSession()).toEqual(sessionNew);
      fetchSpy.assert();
    });

    popupSpy.mockClear();
  });
});
