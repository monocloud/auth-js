  it('Silent Mode - should redirect iframe to sign in page and resolve when a session message is received', async () => {
    const fetchSpy = fetchBuilder().configureMetadata().createSpy();

    mockWindow.assert();

    const iframe = window.document.createElement('iframe');

    const createElementSpy = vi
      .spyOn(window.document, 'createElement')
      .mockReturnValue(iframe);
    const contentWindowSpy = vi
      .spyOn(iframe, 'contentWindow', 'get')
      .mockReturnValue(window);
    const appendChildSpy = vi.spyOn(window.document.body, 'appendChild');
    const setAttributeSpy = vi
      .spyOn(iframe, 'setAttribute')
      .mockImplementation(() => {});

    const instance = testInstance({ storage });

    instance.signIn({ mode: 'silent' }).then();

    await vi.waitFor(() => {
      storage
        .expectCallbackState()
        .expectCallbackStateMode('silent')
        .expectCallbackStateCodeVerifier()
        .expectCallbackStateMaxAge(undefined)
        .expectCallbackStateNonce()
        .expectCallbackStateParamLocation('query')
        .expectCallbackStateSignOut(undefined)
        .expectCallbackStateState();

      expect(instance.getSession()).toBeUndefined();

      expect(window.document.body.appendChild).toHaveBeenCalledWith(iframe);
      expect(iframe.setAttribute).toHaveBeenLastCalledWith(
        'src',
        expect.stringContaining('https://example.com/connect/authorize')
      );
    });

    const session = { accessToken: 'at', user: { sub: 'sub' } };

    window.dispatchEvent(
      new MessageEvent('message', {
        data: {
          success: true,
          source: 'monocloud-javascript-sdk',
          result: session,
        },
        source: window,
        origin: 'http://localhost:3000',
      })
    );

    await vi.waitFor(() => {
      window.document.body.childNodes.forEach(x => {
        expect(x.nodeName).not.toBe('IFRAME');
      });
      storage.expectSession(session).expectCallbackStateRemoved();
      expect(instance.getSession()).toEqual(session);
      fetchSpy.assert();
    });

    createElementSpy.mockClear();
    contentWindowSpy.mockClear();
    appendChildSpy.mockClear();
    setAttributeSpy.mockClear();
  });

